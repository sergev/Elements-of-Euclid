#import "../functions.typ": *

#content-box[
  #parallel-proposition(16)
  #parallel(
    [Ἐὰν τετράγωνος ἀριθμὸς τετράγωνον ἀριθμὸν μὴ μετρῇ, οὐδὲ ἡ πλευρὰ τὴν πλευρὰν μετρήσει· κἂν ἡ πλευρὰ τὴν πλευρὰν μὴ μετρῇ, οὐδὲ ὁ τετράγωνος τὸν τετράγωνον μετρήσει.],
    [If a square number does not measure a(nother) square number then the side (of the former) will not measure the side (of the latter) either. And if the side (of a square number) does not measure the side (of another square number) then the (former) square (number) will not measure the (latter) square (number) either.],
  )
  #parallel-image("/Book08/fig16", 0.5in)
  #parallel(
    [Ἔστωσαν τετρὰγωνοι ἀριθμοὶ οἱ Α, Β, πλευραὶ δὲ αὐτῶν ἔστωσαν οἱ Γ, Δ, καὶ μὴ μετρείτω ὁ Α τὸν Β· λὲγω, ὅτι οὐδὲ ὁ Γ τὸν Δ μετρεῖ.],
    [Let $A$ and $B$ be square numbers, and let $C$ and $D$ be their sides (respectively). And let $A$ not measure $B$. I say that $C$ does not measure $D$ either.],
  )
  #parallel(
    [Εἰ γὰρ μετρεῖ ὁ Γ τὸν Δ, μετρήσει καὶ ὁ Α τὸν Β. οὐ μετρεῖ δὲ ὁ Α τὸν Β· οὐδὲ ἄρα ὁ Γ τὸν Δ μετρήσει.],
    [For if $C$ measures $D$ then $A$ will also measure $B$ [Prop.~8.14]. And $A$ does not measure $B$. Thus, $C$ will not measure $D$ either.],
  )
  #parallel(
    [μὴ μετρείτω [δὴ] πάλιν ὁ Γ τὸν Δ· λέγω, ὅτι οὐδὲ ὁ Α τὸν Β μετρήσει.],
    [[So], again, let $C$ not measure $D$. I say that $A$ will not measure $B$ either.],
  )
  #parallel(
    [Εἰ γὰρ μετρεῖ ὁ Α τὸν Β, μετρήσει καὶ ὁ Γ τὸν Δ. οὐ μετρεῖ δὲ ὁ Γ τὸν Δ· οὐδ᾿ ἄρα ὁ Α τὸν Β μετρήσει· ὅπερ ἔδει δεῖξαι.],
    [For if $A$ measures $B$ then $C$ will also measure $D$ [Prop.~8.14]. And $C$ does not measure $D$. Thus, $A$ will not measure $B$ either. (Which is) the very thing it was required to show.],
  )
]
