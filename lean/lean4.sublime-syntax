%YAML 1.2
---
# Minimal Lean 4 highlighting for the Typst Lean edition
name: Lean 4
file_extensions: [lean]
scope: source.lean

contexts:
  main:
    - match: '/-'
      scope: punctuation.definition.comment.begin.lean
      push: block-comment
    - match: '--.*$'
      scope: comment.line.double-dash.lean
    - match: '\b(theorem|lemma|def|axiom|by|have|show|from|fun|let|in|at|with|if|then|else|match|set_option|open|namespace|end|import)\b'
      scope: keyword.other.lean
    - match: '\b(euclid_intros|euclid_apply|euclid_assert|euclid_finish|use|by_contra|by_cases|constructor|exact|apply|intro|intros|rcases|obtain|simp|linarith|omega|rw|split_ands|assumption|contradiction|exfalso|left|right|refine|calc|repeat|all_goals|any_goals|first|try)\b'
      scope: entity.name.function.tactic.lean
    - match: '\bas\b'
      scope: keyword.other.lean
    - match: "\\b(proposition_[0-9]+'*)"
      scope: entity.name.lean
    - match: '\b(Point|Line|Circle|Segment|Angle|Triangle|Prop|True|False)\b|ℝ'
      scope: support.type.lean
    - match: '\b[0-9]+\b'
      scope: constant.numeric.lean

  block-comment:
    - meta_scope: comment.block.lean
    - match: '-/'
      scope: punctuation.definition.comment.end.lean
      pop: true
